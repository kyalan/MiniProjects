# Copy this file to .env in the project folder. Docker Compose reads .env
# automatically. The admin account is created from the DJANGO_SUPERUSER_*
# values the next time the web container starts:
#   docker compose up -d --force-recreate web
POSTGRES_DB=gymrooms
POSTGRES_USER=gymrooms
POSTGRES_PASSWORD=gymrooms
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=gymrooms-admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
