# Local only. Copy this file to .env.local. Do not commit .env.local.
# The studio also accepts a Gemini key in the page. That key is never written into session backups.
GEMINI_API_KEY=

# Sign-in for the page. Both are required. Restart after you change them.
# APP_USER is the ID you type. APP_PASSWORD is the password. Pick your own.
APP_USER=
APP_PASSWORD=
