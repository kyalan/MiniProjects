# Local only. Copy this file to .env.local.
# The studio also accepts a Gemini key in the page. The key is never written into session backups.
GEMINI_API_KEY=

# Sign-in for the studio. Set both, then restart. The page will not open until these are set.
APP_LOGIN_ID=
APP_LOGIN_PASSWORD=

# Optional. If you leave this blank, signing in again is required after each restart.
APP_SESSION_SECRET=
